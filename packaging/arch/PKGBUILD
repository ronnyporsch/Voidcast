# Builds the desktop app from the committed HEAD of the repository this PKGBUILD lives in.
# Usage: cd packaging/arch && makepkg -si
pkgname=voidcast
# Derived from the latest vX.Y.Z tag at load time instead of a pkgver() function, so makepkg
# never rewrites this file.
_repo=${startdir%/packaging/arch}
_tag=$(git -C "$_repo" describe --tags --match 'v[0-9]*' --abbrev=0 2>/dev/null || echo v1.0.0)
pkgver=$(printf '%s.r%s.g%s' "${_tag#v}" \
    "$(git -C "$_repo" rev-list --count "$_tag"..HEAD 2>/dev/null || echo 0)" \
    "$(git -C "$_repo" rev-parse --short HEAD)")
pkgrel=1
pkgdesc='Music player for Jellyfin with a Youtube Integration'
arch=('x86_64' 'aarch64')
url='https://github.com/ronnyporsch/Voidcast'
license=('custom')
depends=('java-runtime>=21' 'hicolor-icon-theme' 'vlc')
makedepends=('git')
options=('!debug')
source=("$pkgname::git+file://$_repo"
        'voidcast.desktop'
        'voidcast.sh')
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

build() {
    cd "$pkgname"
    ./gradlew --no-daemon :desktopApp:packageUberJarForCurrentOS
}

package() {
    cd "$pkgname"
    install -Dm644 desktopApp/build/compose/jars/de.ronnyporsch.voidcast-linux-*.jar \
        "$pkgdir/usr/share/java/$pkgname/$pkgname.jar"
    install -Dm755 "$srcdir/voidcast.sh" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "$srcdir/voidcast.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
    install -Dm644 desktopApp/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
}
